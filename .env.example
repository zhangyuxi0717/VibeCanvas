# ----------------------------------------
# VibeCanvas 环境变量参考（全部为占位符，不要填真实密钥进仓库）
#
# 复制成实际使用的文件再改：
#   .env.development  ← npm run dev
#   .env.test         ← npm run test:env
#   .env.production   ← npm run start:prod
# .env 本身保留给本机随手调试，已在 .gitignore 中忽略。
# ----------------------------------------

# 运行环境：development / test / production
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3000
APP_VERSION=dev

# 数据落盘目录（图片任务、配图文件、事件、反馈）。生产必须挂持久磁盘，不能放临时目录。
DATA_DIR=./data
# 构建产物目录（npm run build 的输出）
STATIC_ROOT=./public

# ---------------- 文字模型（OpenAI 兼容 Chat Completions） ----------------
MODEL_API_URL=https://api.example.com/v1/chat/completions
MODEL_NAME=your-text-model
MODEL_API_KEY=replace-me

# ---------------- 照片理解（视觉模型，独立密钥） ----------------
VISION_API_URL=https://api.example.com/v1/chat/completions
VISION_MODEL_NAME=your-vision-model
VISION_API_KEY=replace-me

# ---------------- 每日额度（试用上限） ----------------
GENERATE_DAILY_LIMIT=200
GENERATE_PER_USER_DAILY_LIMIT=20
IMAGE_DAILY_LIMIT=60
IMAGE_PER_USER_DAILY_LIMIT=12
IMAGE_PER_MINUTE=5
IMAGE_QUEUE_LIMIT=20
IMAGE_MAX_CONCURRENT=2

# ---------------- 配图：远程图片接口 ----------------
IMAGE_SERVICE_ENABLED=true
IMAGE_API_URL=https://api.example.com/v1/images/generations
IMAGE_MODEL_NAME=your-image-model
IMAGE_API_KEY=replace-me
IMAGE_SIZE=1024x1024
IMAGE_TIMEOUT_MS=120000
# 配图任务与文件（默认落在 DATA_DIR 下，一般不用单独改）
# IMAGE_TASK_STORE_PATH=./data/image-tasks.json
# IMAGE_TASK_ASSET_DIR=./data

# ---------------- 配图：本地 ComfyUI（可选，与上面的远程接口二选一） ----------------
# COMFYUI_API_URL=http://127.0.0.1:8188
# COMFYUI_WORKFLOW_PATH=./comfyui-workflow.json
# COMFYUI_PROMPT_NODE_ID=6
# COMFYUI_POLL_INTERVAL_MS=1500
# COMFYUI_TIMEOUT_MS=300000
# LOCAL_IMAGE_PATH=

# ---------------- 云端账号与云同步（Supabase，可选） ----------------
# 不填时：作品只保存在浏览器本地，登录/云同步/云端备份不可用，其它功能照常。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=vibecanvas-private
# true 表示云端必须可用，缺配置直接拒绝启动
CLOUD_REQUIRED=false

# ---------------- 小范围试用限制 ----------------
# 名单里的邮箱才能登录并生图；名单长度就是试用人数上限。
TRIAL_ALLOWED_EMAILS=alice@example.com,bob@example.com
TRIAL_MAX_USERS=10
# 名单为空时是否允许任何人访问（默认 false，生产配置缺名单会拒绝启动）
TRIAL_OPEN=false

# ---------------- 付费闭环（默认关闭） ----------------
# 先跑通模拟渠道（BILLING_PROVIDER=mock），再按 docs/BILLING.md 切到支付宝沙箱。
BILLING_ENABLED=false
BILLING_PROVIDER=mock
# 商品表：价格单位是「分」，creditValidDays=0 表示长期有效。
# 下面只是示例，金额和额度可以随便改；改完重启生效。
BILLING_PRODUCTS=[{"id":"starter","title":"体验包","priceFen":990,"credits":30,"creditValidDays":90,"description":"30 张 AI 配图额度，90 天内有效"},{"id":"standard","title":"标准包","priceFen":2900,"credits":120,"creditValidDays":180,"description":"120 张 AI 配图额度，180 天内有效"}]
# 每张 AI 配图消耗多少额度
BILLING_CREDITS_PER_TASK=1
# 新账户赠送（没有登录体系时重复领取风险高，默认 0）
BILLING_SIGNUP_GRANT_CREDITS=0
BILLING_SIGNUP_GRANT_VALID_DAYS=30
# 未支付订单多久关闭（分钟）
BILLING_ORDER_TTL_MINUTES=30
# 供应商状态不确定时，额度最多保留多久（分钟），超过就释放
BILLING_UNCERTAIN_HOLD_MINUTES=30
# 账户凭证签名密钥：至少 32 个字符。生产必须显式设置；开发留空会自动生成到 DATA_DIR/billing/account-secret
BILLING_ACCOUNT_SECRET=
# 运营接口凭证（查询订单/任务、暂停生成、调整额度）；留空则运营接口不开放
ADMIN_TOKEN=

# ---------------- 支付宝（BILLING_PROVIDER=alipay 时填写） ----------------
# 应用私钥放服务器文件里，不要写进仓库；也可以直接把 PEM 内容填在 ALIPAY_PRIVATE_KEY
#（换行写成 \n）。ALIPAY_PUBLIC_KEY 填的是「支付宝公钥」，不是应用公钥。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_PUBLIC_KEY=
# 沙箱网关；正式环境换成 https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 公网 https 地址，支付宝要能从外网 POST 进来；留空则由 APP_ORIGIN 拼出来
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
# 可选：校验 seller_id
ALIPAY_SELLER_ID=

# ---------------- HTTPS 与反向代理 ----------------
# 方式一：Node 直接终止 TLS
TLS_CERT_PATH=
TLS_KEY_PATH=
# 方式二：前面有 Caddy/Nginx 终止 TLS（此时不要设 TLS_*）
# BEHIND_TLS_PROXY=true
# 只有确实在可信代理后面才开；否则 X-Forwarded-For 可被伪造
# TRUST_PROXY=false
# 额外允许的跨域来源，逗号分隔（一般留空，只有前端独立域名时才需要）
# CORS_ALLOWED_ORIGINS=

# ---------------- 安全与可观测 ----------------
ENABLE_HSTS=false
MAX_HEADER_BYTES=16384
REQUEST_TIMEOUT_MS=130000
# 产品事件与反馈（只记事件名和短枚举，不记正文和照片）
TELEMETRY_ENABLED=true
