# 小范围试用部署用：npm run start:prod
# 复制为 .env.production 后逐项填写；这个文件在服务器上，权限设为 600，不要提交。
# 填完先跑一遍自检：
#   node --env-file=.env.production scripts/check-config.js
NODE_ENV=production
PORT=8080
HOST=127.0.0.1
APP_VERSION=0.1.0-trial

# 必须写成用户浏览器地址栏里的真实地址，https 开头，结尾不要带斜杠。
# 用 Cloudflare Tunnel 就先填隧道给的域名，例如 https://vibecanvas-trial.example.com
APP_ORIGIN=https://your-domain.example.com

# 持久磁盘（不要用 /tmp）。建议独立数据盘挂到这个目录。
DATA_DIR=/var/lib/vibecanvas/data
STATIC_ROOT=/var/www/vibecanvas/public

# ---------------- 模型服务 ----------------
MODEL_API_URL=https://api.example.com/v1/chat/completions
MODEL_NAME=your-text-model
MODEL_API_KEY=replace-me
VISION_API_URL=https://api.example.com/v1/chat/completions
VISION_MODEL_NAME=your-vision-model
VISION_API_KEY=replace-me

IMAGE_SERVICE_ENABLED=true
IMAGE_API_URL=https://api.example.com/v1/images/generations
IMAGE_MODEL_NAME=your-image-model
IMAGE_API_KEY=replace-me
IMAGE_SIZE=1024x1024
IMAGE_TIMEOUT_MS=120000

# ---------------- 试用额度（每个 UTC 日重置） ----------------
GENERATE_DAILY_LIMIT=200
GENERATE_PER_USER_DAILY_LIMIT=20
IMAGE_DAILY_LIMIT=60
IMAGE_PER_USER_DAILY_LIMIT=12
IMAGE_PER_MINUTE=5
IMAGE_MAX_CONCURRENT=2

# ---------------- 云端账号（可选） ----------------
# 保留空值 = 只做本地作品，登录按钮会显示「云端未配置」。
# 需要账号体系时填 Supabase，并把 CLOUD_REQUIRED 改成 true。
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vibecanvas-private
CLOUD_REQUIRED=false

# ---------------- 试用名单（人数上限 = 名单条数） ----------------
TRIAL_ALLOWED_EMAILS=tester1@example.com,tester2@example.com
TRIAL_MAX_USERS=5
TRIAL_OPEN=false

# ---------------- HTTPS ----------------
# 推荐：Caddy/Nginx 在前面终止 TLS，Node 只监听 127.0.0.1。
BEHIND_TLS_PROXY=true
TRUST_PROXY=true
ENABLE_HSTS=true
# 若让 Node 自己上 HTTPS，则注释掉 BEHIND_TLS_PROXY，填下面两项：
# TLS_CERT_PATH=/etc/vibecanvas/fullchain.pem
# TLS_KEY_PATH=/etc/vibecanvas/privkey.pem

TELEMETRY_ENABLED=true

# ---------------- 付费闭环 ----------------
# 正式收款前保持 false。沙箱验证通过、退款规则和价格都确认后再改成 true。
BILLING_ENABLED=false
# 生产不允许 mock；沙箱阶段也建议先在本机用 mock 跑通，再换 alipay 沙箱
BILLING_PROVIDER=alipay
BILLING_PRODUCTS=[{"id":"starter","title":"体验包","priceFen":990,"credits":30,"creditValidDays":90,"description":"30 张 AI 配图额度，90 天内有效"}]
BILLING_CREDITS_PER_TASK=1
BILLING_SIGNUP_GRANT_CREDITS=0
BILLING_SIGNUP_GRANT_VALID_DAYS=30
BILLING_ORDER_TTL_MINUTES=30
BILLING_UNCERTAIN_HOLD_MINUTES=30
# 至少 32 个字符，建议 openssl rand -hex 32 生成，只放在服务器上
BILLING_ACCOUNT_SECRET=
# openssl rand -hex 24；留空则运营接口不开放
ADMIN_TOKEN=

# 支付宝：私钥/公钥放在 /etc/vibecanvas/，权限 600，属主为服务运行用户
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=/etc/vibecanvas/alipay-app-private.pem
ALIPAY_PUBLIC_KEY_PATH=/etc/vibecanvas/alipay-public.pem
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=https://your-domain.example.com/api/billing/notify/alipay
ALIPAY_RETURN_URL=https://your-domain.example.com/
ALIPAY_SELLER_ID=
