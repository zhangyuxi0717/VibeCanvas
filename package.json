{
  "name": "vibecanvas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node --env-file=.env.development server.js",
    "start": "node --env-file=.env server.js",
    "start:prod": "node --env-file=.env.production server.js",
    "check:config": "node --env-file-if-exists=.env scripts/check-config.js",
    "check:config:prod": "node --env-file=.env.production scripts/check-config.js",
    "backup:data": "bash scripts/backup-data.sh",
    "backup:db": "node --env-file=.env.production scripts/backup-cloud.js",
    "restore:db": "node --env-file=.env.production scripts/restore-cloud.js",
    "trial": "node scripts/start-trial.mjs",
    "e2e": "node scripts/e2e.mjs",
    "check:ui": "node scripts/resilience.mjs",
    "test": "node --test server.test.js image-service.test.js comfyui-service.test.js work-library.test.js cloud-store.test.js image-prompts.test.js config.test.js cloud-backup.test.js trial-guard.test.js billing.test.js http-security.test.js",
    "test:env": "node --env-file=.env.test --test server.test.js image-service.test.js comfyui-service.test.js work-library.test.js cloud-store.test.js image-prompts.test.js config.test.js cloud-backup.test.js trial-guard.test.js billing.test.js http-security.test.js"
  },
  "dependencies": {
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/space-grotesk": "^5.2.5",
    "@supabase/supabase-js": "^2.58.0",
    "esbuild": "^0.25.12",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide": "^0.468.0",
    "puppeteer-core": "^23.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17"
  }
}
