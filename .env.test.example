# 自动化测试用：npm run test:env
# 复制为 .env.test。测试用假密钥和临时目录，绝不连真实模型或真实数据库。
NODE_ENV=test
PORT=3199
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3199
DATA_DIR=./.tmp-test-data
STATIC_ROOT=./public

MODEL_API_URL=http://127.0.0.1:1/v1/chat/completions
MODEL_NAME=test-model
MODEL_API_KEY=test-key
VISION_API_URL=http://127.0.0.1:1/v1/chat/completions
VISION_MODEL_NAME=test-vision
VISION_API_KEY=test-key

IMAGE_SERVICE_ENABLED=false
IMAGE_API_URL=http://127.0.0.1:1/v1/images/generations
IMAGE_MODEL_NAME=test-image
IMAGE_API_KEY=test-key

GENERATE_DAILY_LIMIT=5
GENERATE_PER_USER_DAILY_LIMIT=2
IMAGE_DAILY_LIMIT=5
IMAGE_PER_USER_DAILY_LIMIT=2

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CLOUD_REQUIRED=false
TRIAL_ALLOWED_EMAILS=
TRIAL_MAX_USERS=10

# 测试不写事件文件
TELEMETRY_ENABLED=false
